<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ cloud-backup and device-transfer exclusion for the DATA-08
  receipt-photo directory. See auto_backup_rules.xml for the legacy (API
  <=30) mechanism and the app_flutter/receipts/ path derivation. Both files
  are required together; neither supersedes the other across minSdk=26's
  supported API range.

  domain MUST be "root", not "file" — the data-extraction-rules parser shares
  FullBackup.BackupScheme.getDirectoryForCriteriaDomain() with the legacy
  parser, so "file" resolves to {dataDir}/files/ and would never match
  {dataDir}/app_flutter/receipts/. See 01-REVIEW.md CR-01.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/receipts/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/receipts/"/>
    </device-transfer>
</data-extraction-rules>
